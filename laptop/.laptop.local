#!/bin/sh

# Laptop extras
# https://github.com/dmoellenbeck/laptop

fancy_echo "Updating PATH..."
# shellcheck disable=SC2016
append_to_zshrc 'export PATH="$HOME/.local/bin:$PATH"'

fancy_echo "Adding additional Homebrew formulae ..."
brew bundle --file=- <<EOF
tap "olets/tap"

brew "asdf"
brew "bat"
brew "diff-so-fancy"
brew "eza"
brew "fd"
brew "fzf"
brew "lazygit"
brew "neovim"
brew "readline"
brew "ripgrep"
brew "rsync"
brew "rust"
brew "shellcheck"
brew "starship"
brew "stow"
brew "tmux"
brew "tree"
brew "wget"
brew "yamllint"
brew "yq"
brew "zoxide"
brew "olets/tap/zsh-abbr"

cask "font-cascadia-code-nf"
cask "iterm2"
EOF

fancy_echo "Installing latest Python ..."
add_or_update_asdf_plugin "python" "https://github.com/asdf-community/asdf-python.git"
install_asdf_language "python"

fancy_echo "Installing Lua 5.4.7 (5.5 is incompatible with LuaRocks) ..."
add_or_update_asdf_plugin "lua" "https://github.com/Stratus3D/asdf-lua.git"
if ! asdf list lua 2>/dev/null | grep -Fq "5.4.7"; then
  asdf install lua 5.4.7 || fancy_echo "WARNING: Lua installation failed, continuing..."
fi
asdf global lua 5.4.7 2>/dev/null || true

fancy_echo "Installing basic gems..."
gem install overcommit
gem install tmuxinator

fancy_echo "Installing Claude Code..."
npm install -g @anthropic-ai/claude-code

fancy_echo "Laptop script finished successfully! Please restart your terminal."
echo
