# Brewfile.macmini
#
# Mac Mini PowerHouse - Server and desktop hybrid
# Extends the base Brewfile with server tools, Docker support,
# monitoring, and shared personal/development packages.
#
# Role: Development server, Docker host (Paperless-ngx), 24/7 services, Desktop
#
# Related:
#   - https://github.com/dmoellenbeck/home_lab/issues/1
#   - https://github.com/dmoellenbeck/home_lab/issues/2
#
# Usage:
#   brew bundle --file=brew/Brewfile.macmini
#

# =============================================================================
# Shared: Personal + Mac Mini packages
# =============================================================================
brew "dotnet"
brew "gemini-cli"
brew "go"
brew "imap-backup"
brew "imapsync"
brew "kubernetes-cli"
brew "lsd"
brew "mackup"
brew "midnight-commander"
brew "nvm"
brew "ocrmypdf"
brew "ollama"
brew "pnpm"
brew "xcodegen"

# =============================================================================
# Backup & Sync Tools
# =============================================================================
# restic - Fast, secure backup program
brew "restic"

# rclone - Rsync for cloud storage (OneDrive, Google Drive, etc.)
brew "rclone"

# =============================================================================
# Monitoring & Observability
# =============================================================================
# glances - Cross-platform system monitoring (better than htop for servers)
brew "glances"

# Note: Prometheus and Grafana are better run as Docker containers
# for production use. Install via Docker Compose instead:
# - ghcr.io/prometheus/prometheus
# - grafana/grafana

# =============================================================================
# Paperless-ngx Support (Document Management)
# =============================================================================
# tesseract - OCR engine for document text extraction
brew "tesseract"

# tesseract language packs (German + English)
brew "tesseract-lang"

# =============================================================================
# Network Administration Tools
# (For UniFi network management from Mac Mini)
# =============================================================================
# mtr - Network diagnostic tool (traceroute + ping)
brew "mtr"

# dog - Modern DNS client (like dig, but better)
brew "dog"

# =============================================================================
# Server Utilities
# =============================================================================
# screen - Terminal multiplexer (alternative to tmux for background jobs)
brew "screen"

# mosh - Mobile shell (better SSH for unstable connections)
brew "mosh"

# =============================================================================
# Development Tools (Server-specific)
# =============================================================================
# dive - Explore Docker image layers
brew "dive"

# ctop - Container metrics (top for containers)
brew "ctop"

# =============================================================================
# Casks
# =============================================================================
# Parallels - Virtualization
cask "parallels"
cask "parallels-toolbox"

# ScanSnap - Document scanner
cask "fujitsu-scansnap-home"

# Stats - System monitor in menu bar
cask "stats"

# vim: set filetype=ruby:
